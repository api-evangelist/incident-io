            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update alert source"
        },
        {
          "info": {
            "name": "Delete alert source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.incident.io/v2/alert-sources/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete alert source"
