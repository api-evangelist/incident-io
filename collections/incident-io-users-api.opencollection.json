{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incident.io Actions Users API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listUsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.incident.io/v2/users"
          }
        },
        {
          "info": {
            "name": "getUser",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.incident.io/v2/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}