{
  "opencollection": "1.0.0",
  "info": {
    "name": "Incident.io Actions Alerts API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.incident.io/v2/alerts"
          },
          "docs": "List alerts"
        },
        {
          "info": {
            "name": "Show a single alert",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.incident.io/v2/alerts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Show a single alert"
        },
        {
          "info": {
            "name": "Create an alert event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.incident.io/v2/alert-events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an alert event"
        }
      ]
    }
  ],
  "bundled": true
}